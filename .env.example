# --- Telegram ---
BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# --- Marzban panel ---
MARZBAN_BASE_URL=https://panel.example.com
MARZBAN_USERNAME=
MARZBAN_PASSWORD=

# --- Payment (card-to-card) ---
CARD_NUMBER=XXXX-XXXX-XXXX-XXXX
CARD_HOLDER_NAME=
CURRENCY_LABEL=Toman

# --- Plans ---
# Plans are managed in the database by the admin via /plans command.
# No env vars needed — use the Telegram admin panel to add/edit/toggle plans.

# --- Welcome sticker (optional) ---
# Forward any sticker to @userinfobot to get its file_id, then paste it here.
# Leave empty to skip sending a sticker on /start.
WELCOME_STICKER_ID=

# --- Static text / links ---
HOW_TO_CONNECT_TEXT=Install v2rayNG / NekoBox / Streisand and paste your link.
SUPPORT_URL=

# --- NOWPayments (crypto, optional) ---
# Leave NOWPAYMENTS_API_KEY empty to disable crypto payments entirely.
# Email + password are required by the "Check Payment" button to obtain a JWT
# from POST /v1/auth (the GET /payment endpoint requires Bearer JWT — there is
# no x-api-key way to find a payment by order_id). If you log in via Google,
# go to your NOWPayments profile/security and add a password — both methods
# coexist.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=

# --- Proxy (optional) ---
# Required when api.telegram.org is not directly reachable.
# Format: socks5h://USER:PASSWORD@HOST:PORT
# The "h" suffix means the proxy resolves hostnames (recommended).
# Leave empty for a direct connection.
TELEGRAM_PROXY_URL=

# --- Database ---
# DB_BACKEND selects the database engine: "sqlite" (default) or "postgres"
DB_BACKEND=sqlite

# SQLite — only used when DB_BACKEND=sqlite
DB_PATH=data/shop.db

# PostgreSQL — only used when DB_BACKEND=postgres
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://shop:secret@localhost:5432/shopdb

# PostgreSQL Docker service variables (used by docker-compose when running with --profile postgres)
POSTGRES_DB=shopdb
POSTGRES_USER=shop
POSTGRES_PASSWORD=secret

# --- Runtime ---
LOG_LEVEL=INFO
